// Prisma Schema for Supabase PostgreSQL
// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  DISTRICT_ADMIN
  FACILITY_ADMIN
  DOCTOR
  HEALTH_WORKER
  PATIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RegistrationStep {
  CREDENTIALS
  EMAIL_VERIFIED
  PROFILE_STEP_1
  PROFILE_STEP_2
  COMPLETE
}

enum FacilityType {
  SUB_CENTRE
  PHC
  CHC
  RURAL_HOSPITAL
  DISTRICT_HOSPITAL
  DIAGNOSTIC_CENTER
  PHARMACY
}

enum AppointmentType {
  IN_PERSON
  TELE_OPD
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReferralPriority {
  ROUTINE
  URGENT
  HIGH
  CRITICAL
}

enum ReferralStatus {
  CREATED
  ACCEPTED
  BED_RESERVED
  PATIENT_ARRIVED
  COMPLETED
  CANCELLED
}

enum TriagePriority {
  ROUTINE
  MODERATE
  CRITICAL
}

enum MchRiskLevel {
  NORMAL
  HIGH_RISK
}

enum DiagnosticStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Core Identity ────────────────────────────────────────────────────────────

model User {
  id            String     @id // == supabase auth.users.id (UUID)
  role          UserRole
  status        UserStatus @default(PENDING_VERIFICATION)
  fullName      String     @map("full_name")
  phone         String?    @unique
  email         String?    @unique
  avatarUrl     String?    @map("avatar_url")
  preferredLang String     @default("en") @map("preferred_lang")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  patient              Patient?
  healthWorker         HealthWorker?
  doctor               Doctor?
  facilityAdmin        FacilityAdmin?
  districtAdmin        DistrictAdmin?
  registrationProgress RegistrationProgress?
  createdReferrals     Referral[]             @relation("UserCreatedReferrals")
  assessedTriages      TriageAssessment[]     @relation("UserAssessedTriages")

  @@map("users")
}

model RegistrationProgress {
  id          String           @id @default(uuid())
  userId      String           @unique @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStep RegistrationStep @default(CREDENTIALS) @map("current_step")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("registration_progress")
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                Gender?
  village               String?
  district              String?
  state                 String    @default("Maharashtra")
  pincode               String?
  abhaId                String?   @unique @map("abha_id")
  bloodGroup            String?   @map("blood_group")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  facilityId            String?   @map("facility_id")
  facility              Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  medicalHistory    MedicalHistory?
  appointments      Appointment[]
  prescriptions     Prescription[]
  referrals         Referral[]
  triageAssessments TriageAssessment[]
  mchRecords        MchRecord[]
  diagnosticReports DiagnosticReport[]

  @@index([district])
  @@map("patients")
}

model MedicalHistory {
  id                 String   @id @default(uuid())
  patientId          String   @unique @map("patient_id")
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies          String[] @default([])
  chronicConditions  String[] @default([]) @map("chronic_conditions")
  currentMedications String[] @default([]) @map("current_medications")
  notes              String?
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("medical_histories")
}

// ─── Admin Roles ──────────────────────────────────────────────────────────────

model DistrictAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  district  String   // assigned Maharashtra district name, or "ALL" for state-level
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([district])
  @@map("district_admins")
}

model FacilityAdmin {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([facilityId])
  @@map("facility_admins")
}

// ─── Doctor ───────────────────────────────────────────────────────────────────

model Doctor {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  specialty      String?   // e.g. "General Medicine", "Pediatrics", "Obstetrics"
  qualification  String?   // e.g. "MBBS, MD"
  registrationNo String?   @map("registration_no")
  isAvailable    Boolean   @default(true) @map("is_available")
  facilityId     String?   @map("facility_id")
  facility       Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  appointments      Appointment[]
  prescriptions     Prescription[]
  rosterEntries     DoctorRoster[]
  diagnosticReports DiagnosticReport[]

  @@index([facilityId])
  @@index([specialty])
  @@map("doctors")
}

// ─── Health Worker (ASHA / ANM / CHO) ────────────────────────────────────────

model HealthWorker {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workerType  String?   @map("worker_type") // "ASHA", "ANM", "CHO"
  villageArea String?   @map("village_area")
  facilityId  String?   @map("facility_id")
  facility    Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  mchRecords MchRecord[]

  @@index([facilityId])
  @@map("health_workers")
}

// ─── Facilities & Resources ──────────────────────────────────────────────────

model Facility {
  id           String       @id @default(uuid())
  name         String
  type         FacilityType
  district     String       // e.g. "Pune", "Nashik", "Satara"
  village      String?      // e.g. "Ambegaon", "Junnar"
  address      String?
  pincode      String?
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  contactPhone String?      @map("contact_phone")
  contactEmail String?      @map("contact_email")
  workingHours String?      @default("24x7 Emergency / 09:00 - 17:00 OPD") @map("working_hours")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  services          FacilityService[]
  bedStatus         FacilityBedStatus?
  medicines         FacilityMedicine[]
  diagnostics       FacilityDiagnostic[]
  doctors           Doctor[]
  workers           HealthWorker[]
  admins            FacilityAdmin[]
  patients          Patient[]
  appointments      Appointment[]
  prescriptions     Prescription[]
  referralsFrom     Referral[]          @relation("FromFacility")
  referralsTo       Referral[]          @relation("ToFacility")
  triageAssessments TriageAssessment[]
  mchRecords        MchRecord[]
  doctorRosters     DoctorRoster[]
  diagnosticReports DiagnosticReport[]
  slots             FacilitySlot[]

  @@index([district])
  @@index([type])
  @@map("facilities")
}

model FacilityService {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String   // e.g. "General Consultation", "Maternal Care", "Emergency Triage"
  category   String?  // e.g. "OPD", "MCH", "EMERGENCY", "DIAGNOSTICS"
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([facilityId, name])
  @@index([name])
  @@map("facility_services")
}

model FacilityBedStatus {
  id                  String   @id @default(uuid())
  facilityId          String   @unique @map("facility_id")
  facility            Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  totalBeds           Int      @default(10) @map("total_beds")
  availableBeds       Int      @default(5) @map("available_beds")
  icuBedsTotal        Int      @default(0) @map("icu_beds_total")
  icuBedsAvailable    Int      @default(0) @map("icu_beds_available")
  oxygenBedsTotal     Int      @default(2) @map("oxygen_beds_total")
  oxygenBedsAvailable Int      @default(1) @map("oxygen_beds_available")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("facility_bed_status")
}

model FacilityMedicine {
  id             String    @id @default(uuid())
  facilityId     String    @map("facility_id")
  facility       Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicineName   String    @map("medicine_name") // e.g. "Paracetamol 500mg", "Amoxicillin"
  category       String?   // e.g. "Analgesic", "Antibiotic", "Maternal Supplement"
  quantity       Int       @default(100)
  unit           String    @default("strips") // "tablets", "strips", "bottles", "vials"
  stockThreshold Int       @default(20) @map("stock_threshold")
  isAvailable    Boolean   @default(true) @map("is_available")
  expiryDate     DateTime? @map("expiry_date") @db.Date
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([facilityId, medicineName])
  @@index([medicineName])
  @@map("facility_medicines")
}

model FacilityDiagnostic {
  id              String   @id @default(uuid())
  facilityId      String   @map("facility_id")
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  testName        String   @map("test_name") // e.g. "Complete Blood Count (CBC)", "X-Ray Chest"
  category        String?  // e.g. "Pathology", "Radiology", "Biochemistry"
  isAvailable     Boolean  @default(true) @map("is_available")
  turnaroundHours Int      @default(24) @map("turnaround_hours")
  costInr         Int      @default(0) @map("cost_inr") // 0 == Free under Govt scheme
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([facilityId, testName])
  @@index([testName])
  @@map("facility_diagnostics")
}

// ─── Appointments & Consultations ─────────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String?           @map("doctor_id")
  doctor          Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  facilityId      String            @map("facility_id")
  facility        Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type            AppointmentType   @default(IN_PERSON)
  appointmentDate DateTime          @map("appointment_date") @db.Date
  slot            String            @default("10:00 AM - 11:00 AM")
  status          AppointmentStatus @default(BOOKED)
  token           String?
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([doctorId])
  @@index([facilityId, appointmentDate])
  @@map("appointments")
}

// ─── Digital Prescriptions (E-Rx) ─────────────────────────────────────────────

model Prescription {
  id           String             @id @default(uuid())
  patientId    String             @map("patient_id")
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String             @map("doctor_id")
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facilityId   String             @map("facility_id")
  facility     Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  diagnosis    String
  advice       String?
  followUpDate DateTime?          @map("follow_up_date") @db.Date
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  items PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String       @map("medicine_name")
  dosage         String       // e.g. "1 tablet thrice daily"
  duration       String       // e.g. "5 days"
  frequency      String?      // e.g. "TDS"
  instructions   String?      // e.g. "After food"
  inStock        Boolean      @default(true) @map("in_stock")

  @@map("prescription_items")
}

// ─── Inter-Facility Referrals ─────────────────────────────────────────────────

model Referral {
  id                String           @id @default(uuid())
  patientId         String           @map("patient_id")
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromFacilityId    String           @map("from_facility_id")
  fromFacility      Facility         @relation("FromFacility", fields: [fromFacilityId], references: [id], onDelete: Cascade)
  toFacilityId      String           @map("to_facility_id")
  toFacility        Facility         @relation("ToFacility", fields: [toFacilityId], references: [id], onDelete: Cascade)
  createdById       String           @map("created_by_id")
  createdBy         User             @relation("UserCreatedReferrals", fields: [createdById], references: [id], onDelete: Restrict)
  reason            String
  requiredSpecialty String?          @map("required_specialty")
  priority          ReferralPriority @default(ROUTINE)
  status            ReferralStatus   @default(CREATED)
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([fromFacilityId])
  @@index([toFacilityId])
  @@map("referrals")
}

// ─── Doorstep Clinical Triage ─────────────────────────────────────────────────

model TriageAssessment {
  id            String         @id @default(uuid())
  patientId     String?        @map("patient_id")
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName   String         @map("patient_name")
  patientAge    Int?           @map("patient_age")
  patientGender Gender?        @map("patient_gender")
  village       String?
  assessedById  String         @map("assessed_by_id")
  assessedBy    User           @relation("UserAssessedTriages", fields: [assessedById], references: [id], onDelete: Restrict)
  facilityId    String?        @map("facility_id")
  facility      Facility?      @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  bpSystolic    Int?           @map("bp_systolic")
  bpDiastolic   Int?           @map("bp_diastolic")
  spo2          Int?
  temperature   Decimal?       @db.Decimal(4, 1)
  pulse         Int?
  symptoms      String[]       @default([])
  isPregnant    Boolean        @default(false) @map("is_pregnant")
  priority      TriagePriority @default(ROUTINE)
  actionTaken   String?        @map("action_taken")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([assessedById])
  @@index([facilityId])
  @@map("triage_assessments")
}

// ─── Maternal & Child Health (MCH) ────────────────────────────────────────────

model MchRecord {
  id             String       @id @default(uuid())
  patientId      String?      @map("patient_id")
  patient        Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  healthWorkerId String?      @map("health_worker_id")
  healthWorker   HealthWorker? @relation(fields: [healthWorkerId], references: [id], onDelete: SetNull)
  facilityId     String?      @map("facility_id")
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  motherName     String       @map("mother_name")
  age            Int?
  village        String?
  edd            DateTime?    @map("edd") @db.Date
  trimester      String?
  riskLevel      MchRiskLevel @default(NORMAL) @map("risk_level")
  ancCount       Int          @default(0) @map("anc_count")
  hemoglobin     Decimal?     @db.Decimal(4, 1)
  ifaDelivered   Boolean      @default(false) @map("ifa_delivered")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([healthWorkerId])
  @@index([facilityId])
  @@map("mch_records")
}

// ─── Diagnostic Lab Reports ───────────────────────────────────────────────────

model DiagnosticReport {
  id                String           @id @default(uuid())
  patientId         String           @map("patient_id")
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facilityId        String           @map("facility_id")
  facility          Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  doctorId          String?          @map("doctor_id")
  doctor            Doctor?          @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  testName          String           @map("test_name")
  category          String?
  status            DiagnosticStatus @default(COMPLETED)
  sampleCollectedAt DateTime?        @map("sample_collected_at")
  keyResult         String           @map("key_result")
  findings          String?
  normalRange       String?          @map("normal_range")
  verifiedBy        String?          @map("verified_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([facilityId])
  @@map("diagnostic_reports")
}

// ─── Doctor Duty Roster ───────────────────────────────────────────────────────

model DoctorRoster {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  doctorId   String   @map("doctor_id")
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  shiftName  String   @map("shift_name") // e.g. "Morning (09:00 - 15:00)"
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  status     String   @default("ON_DUTY") // "ON_DUTY", "SCHEDULED", "OFF_DUTY"
  tokenQuota Int      @default(30) @map("token_quota")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([facilityId])
  @@index([doctorId])
  @@map("doctor_rosters")
}

// ─── Facility Appointment Slots ────────────────────────────────────────────────

model FacilitySlot {
  id          String   @id @default(uuid())
  facilityId  String   @map("facility_id")
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  slotName    String   @map("slot_name") // e.g. "Morning Slot (09:00 - 11:00)", "Afternoon Slot (14:00 - 16:00)"
  startTime   String   @default("09:00") @map("start_time")
  endTime     String   @default("12:00") @map("end_time")
  maxCapacity Int      @default(20) @map("max_capacity")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([facilityId, slotName])
  @@index([facilityId])
  @@map("facility_slots")
}
